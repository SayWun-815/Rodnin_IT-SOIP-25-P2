<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:xhtml="http://www.w3.org/1999/xhtml">
    <xsl:output method="xml" indent="yes" encoding="UTF-8"/>
    <xsl:template match="/">
        <items>
            <xsl:apply-templates select="//xhtml:body/xhtml:ul" mode="process">
                <xsl:with-param name="parentId" select="0"/>
            </xsl:apply-templates>
        </items>
    </xsl:template>
    <xsl:template match="xhtml:ul" mode="process">
        <xsl:param name="parentId"/>

        <xsl:for-each select="xhtml:li">
            <xsl:variable name="myId" select="count(preceding::xhtml:li) + 1"/>
            
            <item id="{$myId}" parentid="{$parentId}">
                <xsl:attribute name="author">
                    <xsl:value-of select="xhtml:span[@class='author']"/>
                </xsl:attribute>
                <xsl:value-of select="xhtml:p"/>
            </item>
            <xsl:if test="xhtml:ul">
                <xsl:apply-templates select="xhtml:ul" mode="process">
                    <xsl:with-param name="parentId" select="$myId"/>
                </xsl:apply-templates>
            </xsl:if>
        </xsl:for-each>
    </xsl:template>

</xsl:stylesheet>
